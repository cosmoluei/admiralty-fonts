<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>逐字审稿 · Admiralty</title>
<style>/* FONTS */
/* STYLE */</style>
</head>
<body>
<header class="toolbar">
  <nav class="navgroup" aria-label="字形导航">
    <span class="brand">Admiralty</span>
    <button id="prev" aria-label="上一个字形" title="上一个字形（←）">←</button>
    <button id="next" aria-label="下一个字形" title="下一个字形（→）">→</button>
    <h1 id="name"></h1><span id="unicode"></span><span id="pageNumber"></span>
  </nav>
  <div class="actions">
    <button id="search" title="查找字符、名称或码位（/）">查找 <kbd>/</kbd></button>
    <button id="settingsButton" popovertarget="settings">视图</button>
    <button id="issues" aria-label="查看本次标记">标记 <b id="count">0</b></button>
    <button id="export" class="primary" disabled>导出<span class="wide-label">问题</span> ↓</button>
  </div>
</header>
<div id="settings" popover="auto" aria-labelledby="settingsTitle">
  <div class="dialoghead"><h2 id="settingsTitle">审稿视图</h2><button popovertarget="settings" popovertargetaction="hide" aria-label="关闭设置">×</button></div>
  <div class="filters"><label>字型<select id="family"><option value="">全部字型</option></select></label>
    <label>圆角<select id="radius"><option value="">全部</option><option>0</option><option>100</option></select></label>
    <label>采样<select id="sampling"><option value="masters">母版宽度</option><option value="intermediate">含中间插值</option></select></label>
  </div>
  <p id="coverage"></p>
  <div class="viewTools"><button id="overview" aria-pressed="true">适应一屏</button><div class="modes" aria-label="点击样张的操作"><button id="flagMode" aria-pressed="true">点选标记</button><button id="zoomMode" aria-pressed="false">放大圈注</button></div></div>
  <p class="help">← → 翻字 · 悬停放大 · Shift + 点击圈注</p>
</div>
<main>
  <p id="notice" role="alert" hidden></p>
  <div id="status" role="status" aria-live="polite"></div>
  <div id="matrices" class="overview" aria-label="全部组合"></div>
</main>
<aside id="hoverPreview" aria-hidden="true" hidden><div id="hoverSample"></div><div id="hoverLabel"></div></aside>
<dialog id="finder" aria-labelledby="findTitle"><div class="dialoghead"><h2 id="findTitle">查找字形</h2><button data-close aria-label="关闭查找">×</button></div>
  <input id="query" type="search" autocomplete="off" aria-label="字符、字形名称或 Unicode" placeholder="例如 ł、lslash、U+0142">
  <div id="matches" class="list"></div>
</dialog>
<dialog id="lens" aria-labelledby="lensTitle"><div class="dialoghead"><div><h2 id="lensTitle"></h2><p id="lensMeta"></p></div><button data-close aria-label="关闭放大视图">×</button></div>
  <div id="pairTabs" class="modes"><button id="showCurrent" aria-pressed="true">当前组合</button><button id="showRef" aria-pressed="false">对照 Regular 400</button></div>
  <div class="pair" id="pair"><figure><figcaption>当前组合 · 拖动圈注</figcaption><div class="sheet" id="board" tabindex="-1" role="group" aria-label="当前字形圈注区"><div id="large"></div><div id="regions" aria-hidden="true"></div></div></figure>
  <figure><figcaption>Regular 400 · 同宽同圆角</figcaption><div class="sheet" id="reference"></div></figure></div>
  <p id="operatorContext" hidden></p>
  <div class="inputs"><label>字重<input id="customWeight" type="number" min="100" max="900" step="1"></label><label>字宽 %<input id="customWidth" type="number" min="65" max="150" step=".1"></label><label>圆角<input id="customRadius" type="number" min="0" max="100" step="1"></label><button id="applyAxes">查看组合</button></div>
  <label class="noteLabel" for="note">问题备注</label><textarea id="note" rows="2" placeholder="例如：上横穿过竖干时出现台阶"></textarea>
  <div class="lensfooter"><button id="undoRegion">撤销最后一个圈注</button><button id="flagDetail" class="primary"></button></div>
  <small id="detailStatus" role="status"></small>
</dialog>
<dialog id="ledger" aria-labelledby="ledgerTitle"><div class="dialoghead"><h2 id="ledgerTitle">问题清单</h2><button data-close aria-label="关闭问题清单">×</button></div><p id="ledgerMeta"></p><div id="entries" class="list"></div><details id="previous"><summary>已发截图记录 <span id="previousCount"></span></summary><p>导出时会附上此前截图的文字记录，供复查。新增标记会单列，并记录精确字型和轴值。</p><div id="previousEntries" class="list"></div></details><button id="exportList" class="primary">导出全部问题 ↓</button></dialog>
<noscript>请启用 JavaScript 以加载审稿矩阵。</noscript>
<script>const fonts = /* DATA */;
const previousObservations = /* OBSERVATIONS */;
/* APP */</script>
</body></html>

<!doctype html>
<html lang="zh-CN">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admiralty · 标注复查</title>
<style>
  * { box-sizing: border-box }
  body { margin:0; background:#f8f7f2; color:#192821; font:15px/1.4 system-ui,sans-serif }
  main { max-width:1440px; margin:auto; padding:10px 16px }
  header,nav,.details,.actions,.caption,.exports { display:flex; align-items:center; gap:8px; flex-wrap:wrap }
  header { justify-content:space-between; border-bottom:1px solid #bac9bd; padding-bottom:8px }
  h1 { font-size:17px; margin:0 4px 0 0 }
  button,select,textarea,input[type=text] { color:inherit; background:#fffef9; font:inherit; border:1px solid #9eafa3; border-radius:5px; padding:5px 9px }
  button,select,label { cursor:pointer }
  button:disabled { opacity:.45; cursor:default }
  button:focus-visible,select:focus-visible,input:focus-visible,textarea:focus-visible { outline:2px solid #146853; outline-offset:2px }
  #flag[aria-pressed=true] { background:#923a20; color:white; border-color:#923a20 }
  .save { background:#245846; border-color:#245846; color:white }
  .details { justify-content:space-between; margin:7px 0 }
  #meta,#number { font-variant-numeric:tabular-nums }
  #meta { font-size:14px }
  #scope,.hint,.old-note { color:#495e52; font-size:13px }
  label { white-space:nowrap }
  .pair { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; border:1px solid #c6d1c5; background:#c6d1c5 }
  figure { margin:0; min-width:0; background:#fffef9 }
  .caption { justify-content:center; min-height:30px; color:#3c5748; padding:3px 6px; text-align:center; font-size:13px }
  svg { display:block; width:100%; height:min(76vh,48vw); fill:currentColor }
  main:has(#extra:not([hidden])) > .pair:first-of-type svg { height:min(46vw,max(34vh,calc(78vh - 175px))) }
  .drawable { cursor:crosshair; touch-action:none }
  .pair,.pair * { -webkit-user-select:none; user-select:none; -webkit-touch-callout:none }
  .old-ring,.new-ring { fill:none; vector-effect:non-scaling-stroke; pointer-events:none }
  .old-ring { stroke:#ac493b; stroke-width:1.4; stroke-dasharray:5 3 }
  .new-ring { stroke:#006b9f; stroke-width:2.5 }
  .actions { margin-top:8px }
  #comment { flex:1 1 200px; min-width:0 }
  .old-note,.hint { margin:4px 0 }
  .sequence { margin-top:7px }
  .sequence svg { height:min(16vh,22vw) }
  [hidden] { display:none!important }
  #axes { display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:6px 0 }
  #axes label { font-size:13px }
  #weights { display:grid;grid-template-columns:30px repeat(9,minmax(0,1fr));align-items:stretch;gap:1px;text-align:center;user-select:none;-webkit-user-select:none;margin-bottom:6px }
  #weights .legend,#weights button { display:grid;grid-template-rows:18px repeat(2,minmax(0,1fr));align-items:center }
  #weights .legend { font-size:11px;color:#495e52 }
  #weights button { min-width:0;border:0;border-radius:0;padding:2px;background:#fffef9;font-size:12px }
  #weights button[aria-pressed=true] { background:#e1eadf;box-shadow:inset 0 2px #245846 }
  #weights svg { width:100%;height:clamp(30px,5.3vh,57px) }
  .axis-proof .pair svg { height:clamp(225px,calc(100dvh - 355px),58vw) }
  .axis-proof .pair line { stroke:#c7d2c8;stroke-width:1;stroke-dasharray:4 4;vector-effect:non-scaling-stroke }
  dialog { max-width:min(95vw,640px); border:1px solid #9eafa3; border-radius:6px; color:inherit }
  dialog textarea { width:100%; height:32vh }
  @media(max-width:660px) {
    main { padding:7px } header,nav,.exports,.actions { gap:5px }
    header { justify-content:flex-start } button,select,input[type=text] { min-height:36px }
    nav { width:100%; flex-wrap:nowrap } #glyph { min-width:0; flex:1 } #number { white-space:nowrap }
    .actions input { flex-basis:100% } .caption { font-size:12px } .hint { font-size:12px }
    svg,main:has(#extra:not([hidden])) > .pair:first-of-type svg { height:56vw } .sequence svg { height:25vw }
  }
</style>
<main>
  <header>
    <nav aria-label="复查导航">
      <h1>标注复查</h1>
      <select id="glyph" aria-label="跳至字形"></select>
      <button id="prev" aria-label="上一例" title="上一例（←）">←</button>
      <span id="number"></span>
      <button id="next" aria-label="下一例" title="下一例（→）">→</button>
    </nav>
    <div class="exports">
      <button id="download" class="save">导出问题（0）</button>
      <button id="copy">复制给 Codex</button>
    </div>
  </header>
  <div class="details"><strong id="meta"></strong>
    <label><input type="checkbox" id="boxes" checked> 显示原标注</label>
  </div>
  <div id="axes" hidden></div><div id="weights" hidden aria-label="选择字重，对比修前和修后"></div>
  <section class="pair">
    <figure><figcaption class="caption">标注时</figcaption><svg id="old"></svg></figure>
    <figure><figcaption class="caption">本次修订 · 拖动圈注</figcaption><svg id="new" class="drawable" data-field="regions"></svg></figure>
  </section>
  <section class="pair sequence" id="extra" hidden>
    <figure><figcaption class="caption">原完整连字</figcaption><svg id="oldSequence"></svg></figure>
    <figure><figcaption class="caption">修订完整连字 · 拖动圈注</figcaption><svg id="newSequence" class="drawable" data-field="sequenceRegions"></svg></figure>
  </section>
  <div class="actions">
    <button id="flag" aria-pressed="false" title="标记或取消当前组合（F）">仍有问题（F）</button>
    <button id="undo" disabled>撤销上一圈</button>
    <input id="comment" type="text" aria-label="本次备注" placeholder="可选备注，例如：右下转角太尖">
  </div>
  <p class="old-note" id="note" hidden></p>
  <p class="hint">← → 翻页 · 圈注或写备注即标记 · <span id="status" role="status"></span></p>
  <small id="scope"></small>
</main>
<dialog id="manual"><p>把下面的反馈复制到聊天里。</p><textarea id="copyText" readonly aria-label="复查反馈"></textarea><form method="dialog"><button>关闭</button></form></dialog>
<script id="data" type="application/json">/* REVIEW DATA */</script>
<script>
'use strict';
const {rows, annotationFrame, sourceExport, sourceSha256, axisProof} = JSON.parse(document.getElementById('data').textContent);
const $ = id => document.getElementById(id);
const [ox, oy, vw, vh] = annotationFrame.viewBox;
const svgNS = 'http://www.w3.org/2000/svg';
const gridFields = ['family','wdth','RADI'];
const names = [...new Set(rows.map(r => r.issue.glyph))];
for (const name of names) $('glyph').add(new Option(name, name));
$('scope').textContent = names.length + ' 个字形 · ' + rows.length + ' 个标注组合';
for (const id of ['old','new']) $(id).setAttribute('viewBox', annotationFrame.viewBox.join(' '));
for (const id of ['oldSequence','newSequence']) $(id).setAttribute('viewBox','70 300 1300 800');

// Edits belong to an exact original issue and revised font version.
const prefix = 'admiralty.followup.v1/' + sourceSha256 + '/';
const keys = rows.map(({issue, fontSha256}) =>
  prefix + [fontSha256, issue.family, issue.glyph, issue.wght, issue.wdth, issue.RADI].map(encodeURIComponent).join('/'));
const cursorKey = prefix + 'position';
const entries = new Map();
let index = 0, drag = null, canSave = true;
const weightButtons = new Map();
function setupGrid() {
  document.querySelector('main').classList.add('axis-proof');
  document.title = 'Admiralty · '+axisProof.title;
  document.querySelector('h1').textContent=axisProof.title;
  $('scope').textContent=rows.length+' 个修订组合';
  $('glyph').hidden=true;$('axes').hidden=false;$('weights').hidden=false;
  $('boxes').parentNode.hidden=!rows.some(r=>r.issue.regions.length);
  for(const id of ['old','new'])$(id).setAttribute('viewBox',axisProof.viewBox.join(' '));
  document.querySelector('figcaption').textContent='修前';
  for(const [field,title] of [['family','字型'],['wdth','字宽'],['RADI','圆角']]){
    const label=document.createElement('label'), select=document.createElement('select');
    select.id='axis-'+field;label.append(title+' ',select);$('axes').append(label);
    for(const value of new Set(rows.map(r=>r.issue[field])))select.add(new Option(String(value).replace('Admiralty',''),value));
    select.onchange=()=>{const i=rows.findIndex(({issue})=>issue.wght===rows[index].issue.wght && gridFields.every(k=>String(issue[k])===$('axis-'+k).value));if(i>=0)show(i);};
  }
  const legend=document.createElement('div');legend.className='legend';
  for(const text of ['','修前','修后']){const span=document.createElement('span');span.textContent=text;legend.append(span);}
  $('weights').append(legend);
  for(const w of [...new Set(rows.map(r=>r.issue.wght))].sort((a,b)=>a-b)){
    const button=document.createElement('button');button.append(String(w));
    button.setAttribute('aria-label','查看字重 '+w);
    for(const version of ['old','new']){
      const svg=document.createElementNS(svgNS,'svg');svg.setAttribute('viewBox',axisProof.viewBox.join(' '));svg.setAttribute('aria-hidden','true');button.append(svg);
    }
    button.onclick=()=>show(Number(button.dataset.index));
    weightButtons.set(w,button);$('weights').append(button);
  }
}
function updateGrid(issue){
  for(const field of gridFields)$('axis-'+field).value=issue[field];
  rows.forEach((row,i)=>{
    if(!gridFields.every(k=>row.issue[k]===issue[k]))return;
    const button=weightButtons.get(row.issue.wght);
    button.dataset.index=i;button.setAttribute('aria-pressed',String(i===index));
    const [old,revised]=button.querySelectorAll('svg');old.innerHTML=row.old.glyph;revised.innerHTML=row.new.glyph;
  });
}
if(axisProof)setupGrid();
function readEntry(key, raw) {
  if (!raw) { entries.delete(key); return; }
  const data = JSON.parse(raw);
  if (typeof data.active === 'boolean' && Array.isArray(data.circles) && typeof data.note === 'string') entries.set(key, data);
}
try {
  keys.forEach(key => {
    const raw = localStorage.getItem(key);
    try { readEntry(key, raw); } catch { /* Recover the other saved cases. */ }
  });
  const saved=localStorage.getItem(cursorKey);
  index = Math.max(0, saved ? keys.indexOf(saved) : axisProof ? rows.findIndex(({issue})=>issue.wght===400 && issue.wdth===65 && issue.RADI===0) : 0);
} catch { canSave = false; }
const draft = () => entries.get(keys[index]) || {active:false, note:'', circles:[]};
function save(patch) {
  const key = keys[index], entry = {...draft(), ...patch, updatedAt:new Date().toISOString()};
  entries.set(key, entry);
  try { localStorage.setItem(key, JSON.stringify(entry)); } catch { canSave = false; }
  updateControls();
}
function updateControls() {
  const entry = draft(), count = [...entries.values()].filter(x=>x.active).length;
  $('flag').setAttribute('aria-pressed', String(entry.active));
  $('flag').textContent = entry.active ? '已标记 · 取消（F）' : '仍有问题（F）';
  $('undo').disabled = !entry.circles.length;
  $('download').disabled = $('copy').disabled = !count;
  $('download').textContent = '导出问题（' + count + '）';
  $('status').textContent = canSave ? '进度保存在此浏览器' : '当前浏览器无法保存进度，请在关闭前导出';
}
function ring(box, className) {
  const node = document.createElementNS(svgNS,'ellipse');
  node.setAttribute('class', className);
  node.setAttribute('cx', ox + (box.x + box.w/2)*vw);
  node.setAttribute('cy', oy + (box.y + box.h/2)*vh);
  node.setAttribute('rx', box.w*vw/2);
  node.setAttribute('ry', box.h*vh/2);
  return node;
}
function draw() {
  const row = rows[index], entry = draft();
  for (const id of ['old','new','oldSequence','newSequence']) {
    const svg = $(id), isOld = id.startsWith('old'), sequence = id.endsWith('Sequence');
    svg.innerHTML = row[isOld?'old':'new'][sequence?'sequence':'glyph'];
    if(axisProof && !sequence)for(const x of axisProof.cellEdges){
      const guide=document.createElementNS(svgNS,'line');
      for(const [k,v] of Object.entries({x1:x,x2:x,y1:axisProof.viewBox[1],y2:axisProof.viewBox[1]+axisProof.viewBox[3]}))guide.setAttribute(k,v);
      svg.prepend(guide);
    }
    if (!sequence && $('boxes').checked) for (const box of row.issue.regions) svg.append(ring(box,'old-ring'));
    if (!isOld && entry.active) for (const {field,box} of entry.circles) {
      if (field === svg.dataset.field) svg.append(ring(box,'new-ring'));
    }
  }
}
function stopDrag() {
  if (!drag) return;
  const {svg, id} = drag;
  drag = null;
  if (svg.hasPointerCapture(id)) svg.releasePointerCapture(id);
}
function show(next) {
  if (!rows.length) return;
  stopDrag();
  index = Math.max(0, Math.min(rows.length-1, next));
  const r = rows[index].issue;
  if(axisProof)updateGrid(r);
  $('glyph').value = r.glyph;
  $('number').textContent = (index+1) + ' / ' + rows.length;
  $('meta').textContent = r.glyph + ' · ' + r.family.replace('Admiralty','') + ' · 字重 ' + r.wght + ' / 字宽 ' + r.wdth + '% / 圆角 ' + r.RADI;
  $('prev').disabled = index === 0;
  $('next').disabled = index === rows.length-1;
  $('note').hidden = !r.note;
  $('note').textContent = r.note ? '上次备注　' + r.note : '';
  $('extra').hidden = !r.sequence;
  $('comment').value = draft().note;
  try { localStorage.setItem(cursorKey, keys[index]); } catch { canSave = false; }
  draw(); updateControls();
}
function mark() { save({active:!draft().active}); draw(); }
$('flag').onclick = mark;
$('comment').oninput = e => { save({note:e.target.value, active:true}); draw(); };
$('undo').onclick = () => { save({circles:draft().circles.slice(0,-1)}); draw(); };
$('boxes').onchange = draw;
$('prev').onclick = () => show(index-1);
$('next').onclick = () => show(index+1);
$('glyph').onchange = e => { show(rows.findIndex(r=>r.issue.glyph === e.target.value)); e.target.blur(); };
document.addEventListener('keydown', e => {
  if (e.defaultPrevented || e.isComposing || e.metaKey || e.ctrlKey || e.altKey || $('manual').open || !rows.length) return;
  if (e.target.matches('input,textarea,select')) {
    if (e.key === 'Escape' || (e.key === 'Enter' && e.target === $('comment'))) e.target.blur();
    return;
  }
  if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') { e.preventDefault(); show(index+(e.key==='ArrowRight'?1:-1)); }
  else if (e.key.toLowerCase() === 'f' && !e.repeat) { e.preventDefault(); mark(); }
});

// Use SVG coordinates so letterboxing, browser zoom and touch give the same exported region.
function point(svg, e) {
  const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(svg.getScreenCTM().inverse());
  const clamp = n => Math.max(0,Math.min(1,n));
  return [clamp((p.x-ox)/vw), clamp((p.y-oy)/vh)];
}
function bounds(a,b) { return {x:Math.min(a[0],b[0]), y:Math.min(a[1],b[1]), w:Math.abs(a[0]-b[0]), h:Math.abs(a[1]-b[1])}; }
for (const svg of document.querySelectorAll('.drawable')) {
  svg.onselectstart = svg.ondragstart = e => e.preventDefault();
  svg.onpointerdown = e => {
    if (drag || e.button !== 0) return;
    e.preventDefault(); document.activeElement?.blur(); document.getSelection()?.removeAllRanges();
    const start = point(svg,e), live = ring(bounds(start,start),'new-ring');
    drag = {svg, id:e.pointerId, start, live};
    svg.setPointerCapture(e.pointerId); svg.append(live);
  };
  svg.onpointermove = e => {
    if (e.pointerId !== drag?.id || svg !== drag.svg) return;
    const live = ring(bounds(drag.start,point(svg,e)), 'new-ring');
    drag.live.replaceWith(live); drag.live = live;
  };
  svg.onpointerup = e => {
    if (e.pointerId !== drag?.id || svg !== drag.svg) return;
    const box = bounds(drag.start,point(svg,e));
    stopDrag();
    if (box.w > .008 && box.h > .008) save({active:true, circles:[...draft().circles, {field:svg.dataset.field, box}]});
    draw();
  };
  svg.onlostpointercapture = svg.onpointercancel = e => {
    if (e.pointerId === drag?.id && svg === drag.svg) { stopDrag(); draw(); }
  };
}
function report() {
  const issues = [];
  rows.forEach((row,i) => {
    const entry = entries.get(keys[i]);
    if (!entry?.active) return;
    const source = row.issue;
    const regions = field => entry.circles.filter(c=>c.field === field).map(c=>c.box);
    issues.push({...source, fontSha256:row.fontSha256, glyphID:row.glyphID, renderedGlyphID:row.renderedGlyphID,
      note:entry.note, regions:regions('regions'), sequenceRegions:regions('sequenceRegions'),
      originalIssue:{fontSha256:source.fontSha256, glyphID:source.glyphID, regions:source.regions, note:source.note},
      updatedAt:entry.updatedAt});
  });
  return {schema:'admiralty-glyph-review/1', reviewPass:'followup', sourceExport, sourceSha256,
    exportedAt:new Date().toISOString(), annotationFrame, issueCount:issues.length, issues};
}
$('download').onclick = () => {
  const data = report(), blob = new Blob([JSON.stringify(data,null,2)], {type:'application/json'});
  const url = URL.createObjectURL(blob), a = document.createElement('a');
  a.href = url; a.download = 'Admiralty-复查反馈-' + data.exportedAt.replace(/[:.]/g,'-') + '.json';
  document.body.append(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(url),30000);
};
$('copy').onclick = async () => {
  const text = JSON.stringify(report(),null,2);
  try { await navigator.clipboard.writeText(text); $('status').textContent = '已复制，可直接粘贴到聊天'; }
  catch { $('copyText').value = text; $('manual').showModal(); $('copyText').focus(); $('copyText').select(); }
};
window.addEventListener('storage', e => {
  if (!keys.includes(e.key)) return;
  try { readEntry(e.key,e.newValue); } catch { return; }
  if (e.key === keys[index]) {
    if (document.activeElement !== $('comment')) $('comment').value = draft().note;
    if (!drag) draw();
  }
  updateControls();
});
if (rows.length) show(index);
else { document.querySelectorAll('button,select,input').forEach(control=>control.disabled=true); $('status').textContent='没有待复查的标注'; }
</script>
</html>
